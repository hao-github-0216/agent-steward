    "diff --git a/packages/app/login.ts b/packages/app/login.ts\n@@ -1,3 +1,4 @@\n function login() {\n-  return check(user)\n+  return check(user, token)\n+  // 新增 token 檢查\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "diff --git a/packages/app/login.ts b/packages/app/login.ts\n@@ -1,3 +1,4 @@\n function login() {\n-  return check(user)\n+  return check(user, token)\n+  // Add a token check\n"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "diff --git a/packages/app/login.ts b/packages/app/login.ts\n@@ -1,3 +1,4 @@\n function login() {\n-  return check(user)\n+  return check(user, token)\n+  // 新增 token 檢查\n"
          }
        }
      },
      "extractionState": "manual"
    },
