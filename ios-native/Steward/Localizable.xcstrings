      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overwrite"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋過去"
          }
        }
      },
      "extractionState": "manual"
    },
    "重新載入會捨棄還沒存的標註。蓋過去會用目前的 PDF 和標註取代電腦上的版本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloading discards unsaved annotations. Overwriting replaces the file on disk with your current PDF and annotations."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新載入會捨棄還沒存的標註。蓋過去會用目前的 PDF 和標註取代電腦上的版本。"
          }
        }
      },
      "extractionState": "manual"
    },

